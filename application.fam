App(
 appid="flipper_evm_wallet",name="EVM Wallet (testnet)",apptype=FlipperAppType.EXTERNAL,
 entry_point="wallet_main",stack_size=12288,requires=["gui","storage","bt"],
 sources=["firmware/*.c","core/*.c"],
 cdefines=["USE_BIP32_CACHE=0","USE_BIP39_CACHE=0","USE_BIP32_25519_CURVES=0","USE_ETHEREUM=1","USE_PRECOMPUTED_CP=0"],
 fap_private_libs=[Lib(name="crypto",fap_include_paths=["../../vendor/trezor-crypto","../../core","../../vendor/trezor-crypto/chacha20poly1305"],sources=["*.c"],cdefines=["USE_BIP32_CACHE=0","USE_BIP39_CACHE=0","USE_BIP32_25519_CURVES=0","USE_ETHEREUM=1","USE_PRECOMPUTED_CP=0"])],
 fap_category="Tools",fap_version=(0,1),fap_author="Flipper EVM Wallet contributors",
 fap_description="Experimental EVM wallet. Test networks only.",fap_weburl="https://github.com/X-Tray00/flipper-evm-wallet"
)
