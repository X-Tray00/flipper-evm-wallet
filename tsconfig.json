{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "w3c-web-hid", "vite/client"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["extension/src", "extension/tests", "demo"]
}
